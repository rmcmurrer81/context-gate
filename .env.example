# Local mode is the safe default. No cloud resources are created by this project.
CONTEXTGATE_MODE=local

# Optional local company configuration. Copy the tracked examples first.
# CONTEXTGATE_POLICY_PATH=C:\absolute\path\to\source_policy.json
# CONTEXTGATE_MEMORY_PATH=C:\absolute\path\to\company_memory.sqlite3
# CONTEXTGATE_TENANT_ID=local-company
# Semantic profiles are loaded explicitly by your integration; they are not
# discovered from an environment variable by the current release.

# Set these only after the workshop provides the actual environment details.
CONFLUENT_BOOTSTRAP_SERVERS=
CONFLUENT_API_KEY=
CONFLUENT_API_SECRET=
CONFLUENT_CONTEXT_EVENTS_TOPIC=context_events
CONFLUENT_ACTION_REQUESTS_TOPIC=action_requests
CONFLUENT_DECISIONS_TOPIC=context_decisions
